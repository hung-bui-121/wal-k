#!/bin/sh
# Enforces docs/00-governance/COMMIT-POLICY.md
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|bugfix|docs|chore): [a-z0-9].*[^.]$'; then
  echo "commit-msg: subject must match '^(feat|bugfix|docs|chore): <lowercase imperative subject without trailing period>'" >&2
  echo "  got: $subject" >&2
  exit 1
fi

if [ ${#subject} -gt 72 ]; then
  echo "commit-msg: subject longer than 72 characters (${#subject})" >&2
  exit 1
fi

if grep -Eiq '(co-authored-by|signed-off-by|generated with|generated by|claude|codex|openai|anthropic|chatgpt|copilot)' "$msg_file"; then
  echo "commit-msg: attribution/signature lines and AI tool names are not allowed in commit messages" >&2
  exit 1
fi

exit 0
